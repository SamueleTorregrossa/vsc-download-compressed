{
  "name": "compress-download-extension-enhanced",
  "displayName": "SSH-Remote Better Download",
  "description": "A simple extension to more quickly download files from a remote server in VSCode.",
  "version": "0.0.18",
  "publisher": "jsjm",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinshijiming/vsc-download-compressed"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:extension.compress_download"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.compress_download",
        "title": "Fast Download"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.compress_download",
          "when": "remoteName == 'ssh-remote'",
          "group": "navigation",
          "supportsMultipleSelection": true
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Fast Download Configuration",
      "properties": {
        "fastDownload.defaultDownloadLocation": {
          "type": "string",
          "default": "",
          "description": "Default location for downloaded files. eg. /Users/sam/Downloads"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/mocha": "^8.2.2",
    "@types/node": "^12.11.7",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.0.3",
    "vscode": "^1.1.37"
  }
}
